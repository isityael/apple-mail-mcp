{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>isityael/infra//.github/renovate/base.json",
    "config:best-practices",
    ":preserveSemverRanges"
  ],
  "enabledManagers": [
    "pep621",
    "npm",
    "woodpecker",
    "mise"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "pep621"
      ],
      "addLabels": [
        "python"
      ]
    },
    {
      "matchManagers": [
        "npm"
      ],
      "addLabels": [
        "npm"
      ]
    },
    {
      "matchManagers": [
        "woodpecker"
      ],
      "addLabels": [
        "docker"
      ]
    },
    {
      "description": "DHI Node Alpine CI images: compare Alpine rebases while keeping the dev variant",
      "matchManagers": [
        "woodpecker"
      ],
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "dhi.io/node"
      ],
      "versioning": "regex:^(?<major>\\d+)(\\.(?<minor>\\d+))?(\\.(?<patch>\\d+))?(-alpine(?<build>\\d+\\.\\d+))?-(?<compatibility>dev)$"
    },
    {
      "description": "Auto-merge patch and minor Python dependency updates",
      "matchManagers": [
        "pep621"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "automerge": true
    },
    {
      "description": "Use container version tags only.",
      "matchDatasources": [
        "docker"
      ],
      "pinDigests": false
    },
    {
      "description": "Do not create container digest pins or digest refreshes.",
      "matchDatasources": [
        "docker"
      ],
      "matchUpdateTypes": [
        "digest",
        "pinDigest"
      ],
      "enabled": false
    },
    {
      "description": "One reviewed weekly dependency refresh, including majors, charts, images and tooling.",
      "matchPackageNames": [
        "*"
      ],
      "groupName": "weekly dependencies",
      "groupSlug": "weekly-dependencies",
      "groupSingleUpdates": true,
      "minimumGroupSize": 1,
      "additionalBranchPrefix": "",
      "separateMajorMinor": false,
      "separateMinorPatch": false,
      "separateMultipleMajor": false,
      "separateMultipleMinor": false,
      "schedule": [
        "* 0-5 * * 1"
      ],
      "automerge": false
    }
  ],
  "pinDigests": false,
  "ignorePresets": [
    "docker:pinDigests"
  ],
  "timezone": "Europe/Berlin",
  "schedule": [
    "* 0-5 * * 1"
  ],
  "separateMajorMinor": false,
  "separateMinorPatch": false,
  "separateMultipleMajor": false,
  "separateMultipleMinor": false,
  "prConcurrentLimit": 1,
  "automerge": false,
  "lockFileMaintenance": {
    "enabled": false
  }
}
