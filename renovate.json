{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>m0sh1/infra//.github/renovate/base.json",
    "config:best-practices",
    ":preserveSemverRanges"
  ],
  "enabledManagers": [
    "pep621",
    "npm",
    "woodpecker",
    "mise"
  ],
  "packageRules": [
    {
      "matchManagers": ["pep621"],
      "addLabels": ["python"]
    },
    {
      "matchManagers": ["npm"],
      "addLabels": ["npm"]
    },
    {
      "matchManagers": ["woodpecker"],
      "addLabels": ["docker"]
    },
    {
      "description": "DHI Node Alpine CI images: compare Alpine rebases while keeping the dev variant",
      "matchManagers": ["woodpecker"],
      "matchDatasources": ["docker"],
      "matchPackageNames": ["dhi.io/node"],
      "versioning": "regex:^(?<major>\\d+)(\\.(?<minor>\\d+))?(\\.(?<patch>\\d+))?(-alpine(?<build>\\d+\\.\\d+))?-(?<compatibility>dev)$"
    },
    {
      "description": "Group semantic-release tooling",
      "matchPackageNames": ["/semantic-release/"],
      "groupName": "semantic-release"
    },
    {
      "description": "Auto-merge patch and minor Python dependency updates",
      "matchManagers": ["pep621"],
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": true
    }
  ]
}
